---
import markUrl from "@trop/design-system/assets/tool-mark.svg?url";
import harborLightUrl from "@trop/design-system/assets/harbor-hero-light.png?url";
import harborDarkUrl from "@trop/design-system/assets/harbor-hero-dark.png?url";
import "@trop/design-system/site.css";
import "@trop/design-system/styles.css";
import { siteConfig } from "../site.config.mjs";

const siteBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const sitePath = (path: string = "") =>
  `${siteBase}${path.replace(/^\/+/, "")}`;
const isExternal = (href: string) => /^https?:\/\//.test(href);
const resolveHref = (href: string) =>
  isExternal(href) || href.startsWith("#") ? href : sitePath(href);
const externalRel = (href: string) =>
  isExternal(href) ? "noopener noreferrer" : undefined;
const externalTarget = (href: string) =>
  isExternal(href) ? "_blank" : undefined;
---

<!doctype html>
<html lang={siteConfig.site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteConfig.project.title} | {siteConfig.project.tagline}</title>
    <meta name="description" content={siteConfig.project.description} />
    <meta property="og:title" content={siteConfig.project.title} />
    <meta property="og:description" content={siteConfig.project.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteConfig.site.url} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={sitePath("favicon.svg")} type="image/svg+xml" />
    <link
      rel="preload"
      as="image"
      href={harborLightUrl}
      fetchpriority="high"
      data-theme-hero-preload="light"
    />
    <link
      rel="preload"
      as="image"
      href={harborDarkUrl}
      fetchpriority="high"
      data-theme-hero-preload="dark"
    />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("trop-theme");
          if (theme === "light" || theme === "dark") {
            document.documentElement.dataset.theme = theme;
          }
        } catch {
          // Storage can be unavailable in privacy-restricted browsing contexts.
        }
      })();
    </script>
  </head>
  <body class="landing-page">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-site-header>
      <nav class="site-nav" aria-label="Primary navigation">
        <a
          class="site-nav__brand"
          href={sitePath()}
          aria-label={`${siteConfig.project.title} home`}
        >
          <img src={markUrl} alt="" width="36" height="36" />
          <span>{siteConfig.project.title}</span>
        </a>

        <div class="site-nav__links">
          {
            siteConfig.landing.nav.map((link) => (
              <a
                class="site-nav__link"
                href={resolveHref(link.href)}
                target={externalTarget(link.href)}
                rel={externalRel(link.href)}
              >
                {link.label}
              </a>
            ))
          }
        </div>

        <div class="site-nav__actions">
          <div
            class="theme-toggle"
            role="radiogroup"
            aria-label="Color theme"
            data-ds-component="ThemeToggle"
            data-theme-toggle
          >
            <button
              type="button"
              role="radio"
              data-theme-mode="system"
              title="System"
            >
              <span class="sr-only">System</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                <path d="M8 21h8M12 17v4"></path>
              </svg>
            </button>
            <button
              type="button"
              role="radio"
              data-theme-mode="light"
              title="Light"
            >
              <span class="sr-only">Light</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path
                  d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
                ></path>
              </svg>
            </button>
            <button
              type="button"
              role="radio"
              data-theme-mode="dark"
              title="Dark"
            >
              <span class="sr-only">Dark</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
              </svg>
            </button>
          </div>
          <button
            class="site-nav__toggle"
            type="button"
            aria-label="Open navigation"
            aria-controls="mobile-nav"
            aria-expanded="false"
            data-nav-toggle
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </nav>

      <div class="mobile-nav" id="mobile-nav" data-nav-panel hidden>
        {
          siteConfig.landing.nav.map((link) => (
            <a
              class="mobile-nav__link"
              href={resolveHref(link.href)}
              target={externalTarget(link.href)}
              rel={externalRel(link.href)}
              data-nav-link
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </header>

    <main id="main">
      <section class="hero section-shell" aria-labelledby="hero-title">
        <div class="hero__copy">
          <div class="hero__brand-line">
            <img src={markUrl} alt="" width="64" height="64" />
            <h1 id="hero-title">{siteConfig.project.title}</h1>
          </div>
          <p class="hero__lede">{siteConfig.project.tagline}</p>
          <p class="hero__body">
            If you keep several Git worktrees checked out at once—or have a
            couple of coding agents running dev servers and test suites in
            parallel—hardcoded localhost ports collide right away, while picking
            a random port on every run breaks open browser tabs,
            <code>.env</code> files, and OAuth callbacks.
          </p>
          <p class="hero__body">
            <code>trop</code> is a small Rust CLI that keeps a local SQLite table
            of directory-to-port assignments in <code>~/.trop</code>, handing each
            checkout a free port the first time and returning that same number on
            future runs.
          </p>

          <div class="hero__actions">
            <a
              class="button button--primary"
              href={resolveHref(siteConfig.landing.primaryCta.href)}
              target={externalTarget(siteConfig.landing.primaryCta.href)}
              rel={externalRel(siteConfig.landing.primaryCta.href)}
              data-ds-component="Button"
              data-ds-variant="primary"
              data-ds-size="md"
            >
              {siteConfig.landing.primaryCta.label}
              <svg class="button__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
            <a
              class="button button--secondary"
              href={resolveHref(siteConfig.landing.secondaryCta.href)}
              target={externalTarget(siteConfig.landing.secondaryCta.href)}
              rel={externalRel(siteConfig.landing.secondaryCta.href)}
              data-ds-component="Button"
              data-ds-variant="secondary"
              data-ds-size="md"
            >
              {siteConfig.landing.secondaryCta.label}
            </a>
          </div>
        </div>

        <div
          class="command-card"
          id="install"
          aria-labelledby="command-card-title"
          data-ds-component="CommandCard"
        >
          <div class="command-card__header">
            <div>
              <h2 id="command-card-title">
                {siteConfig.landing.terminal.title}
              </h2>
            </div>
            <span>{siteConfig.landing.terminal.meta}</span>
          </div>
          <pre
            class="command-card__body"><code>{siteConfig.landing.terminal.lines.join("\n")}</code></pre>
          <p class="command-card__note">{siteConfig.landing.terminal.note}</p>
          <button
            class="copy-button"
            type="button"
            data-copy-text={siteConfig.landing.terminal.copy}
            aria-label={`Copy install command: ${siteConfig.landing.terminal.copy}`}
            data-ds-component="CopyButton"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="8" y="8" width="11" height="12" rx="2"></rect>
              <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
            </svg>
            <span>Copy install command</span>
            <span class="sr-only" data-copy-status aria-live="polite"></span>
          </button>
        </div>
      </section>

      <section
        class="section section-shell model-strip"
        id="model"
        aria-labelledby="model-title"
      >
        <div class="section-heading">
          <h2 id="model-title">How it works</h2>
          <p>
            <code>trop reserve</code> checks your configured port range
            (5000–7000 by default), probes localhost on IPv4 and IPv6 to skip
            ports already in use, writes the choice to
            <code>~/.trop/trop.db</code>, and prints the port. Run it again from
            the same directory later—even after your server has stopped—and it
            returns that stored number.
          </p>
          <p>
            When one directory needs several ports, pass tags like
            <code>trop reserve --tag web</code> and
            <code>trop reserve --tag api</code>, or list the services in a
            <code>trop.yaml</code> file and run <code>trop autoreserve</code>.
            Run <code>trop prune</code> to clear out entries for deleted
            worktrees.
          </p>
        </div>
      </section>

      <section
        class="section section-shell scope-strip"
        id="status"
        aria-labelledby="status-title"
      >
        <div class="section-heading">
          <h2 id="status-title">Limits and project status</h2>
          <p>
            <code>trop</code> only coordinates processes that read the same
            local database—typically one user account on one machine. A
            reservation records a number; it does not run a background daemon,
            proxy traffic, or hold sockets open, so unrelated programs can still
            bind the port.
          </p>
          <p>
            This is a personal side project, built partly for multi-worktree
            workflows and partly as an experiment in spec-driven, agent-assisted
            Rust development. Its SQLite storage rules and test suite were put
            together with care, though at <code>v0.2.0</code> it has seen
            limited use outside its author's setup, and CLI flags or config
            details may still change before <code>1.0</code>.{" "}
            <a
              class="text-link"
              href={sitePath("guides/overview/#project-status")}
            >
              Overview &amp; scope
            </a>
          </p>
        </div>
      </section>

      <section
        class="section section-shell docs-preview"
        aria-labelledby="docs-title"
      >
        <div class="section-heading">
          <h2 id="docs-title">Documentation</h2>
        </div>
        <div class="docs-grid">
          {
            siteConfig.docs.pages.map((page) => (
              <article class="doc-card" data-ds-component="DocCard">
                <h3>
                  <a class="text-link" href={resolveHref(page.href)}>
                    {page.title}
                  </a>
                </h3>
                <p>{page.description}</p>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="section-shell site-footer__inner">
        <p>{siteConfig.project.title}</p>
        <nav aria-label="Footer">
          {
            siteConfig.landing.footerLinks.map((link) => (
              <a
                href={resolveHref(link.href)}
                target={externalTarget(link.href)}
                rel={externalRel(link.href)}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </footer>

    <script>
      import "../scripts/landing.ts";
    </script>
  </body>
</html>
